# Copy these settings into your deployment environment (do not commit real secrets).
# Configure one or more studios as a JSON array in Render's STUDIO_PROFILES_JSON.
STUDIO_PROFILES_JSON=[{"id":"studio-one","name":"Studio One","package_id":"com.example.questapp","access_token":"OC|YOUR_APP_ID|YOUR_APP_SECRET","allowed_cert_sha256":["REPLACE_WITH_64_HEX_SHA256"],"allowed_device_serials":["REPLACE_WITH_QUEST_SERIAL"]}]

# Optional settings
CHALLENGE_TTL_SECONDS=300
META_MAX_TOKEN_AGE_SECONDS=600
META_HTTP_TIMEOUT_SECONDS=15
META_ACCEPTED_DEVICE_STATES=Advanced,Basic
# META_VERIFY_URL=https://graph.oculus.com/platform_integrity/verify

# Optional legacy single-studio configuration (only used when STUDIO_PROFILES_JSON is empty)
# META_STUDIO_NAME=Default Studio
# META_APP_ACCESS_TOKEN=OC|YOUR_APP_ID|YOUR_APP_SECRET
# META_PACKAGE_ID=com.example.questapp
# META_ALLOWED_CERT_SHA256=REPLACE_WITH_64_HEX_SHA256
# META_ALLOWED_DEVICE_SERIALS=REPLACE_WITH_QUEST_SERIAL

# Optional ADB proxy settings
# ADB_AGENT_URL=https://your-private-agent.example
# ADB_AGENT_TOKEN=use-a-long-random-secret
